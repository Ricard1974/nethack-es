#: dat/rumors.fal:25
msgid "[cookie] A wish?  Okay, make me a fortune cookie!"
msgstr "[galleta] ¿Un deseo?  Vale, ¡hazme una galleta de la fortuna!"

#: dat/rumors.fal:80
msgid "[cookie] Help!  I'm being held prisoner in a fortune cookie factory!"
msgstr ""
"[galleta] ¡Ayuda!  ¡Me tienen prisionero en una fábrica de galletas de la "
"fortuna!"

#: dat/rumors.fal:131
msgid ""
"[cookie] No part of this fortune may be reproduced, stored in a retrieval "
"system, ..."
msgstr ""
"[galleta] Ninguna parte de esta fortuna puede ser reproducida, almacenada en"
" un sistema de recuperación, ..."

#: dat/rumors.fal:160
msgid "[cookie] Sorry, no fortune this time.  Better luck next cookie!"
msgstr ""
"[galleta] Lo siento, no hay fortuna esta vez.  ¡Más suerte en la próxima "
"galleta!"

#: dat/rumors.fal:193
msgid ""
"[cookie] They say that a fortune only has 1 line and you can't read between "
"it."
msgstr ""
"[galleta] Dicen que una fortuna solo tiene 1 línea y no puedes leer entre "
"ella."

#: dat/rumors.fal:194
msgid ""
"[cookie] They say that a fortune only has 1 line, but you can read between "
"it."
msgstr ""
"[galleta] Dicen que una fortuna solo tiene 1 línea, pero puedes leer entre "
"ella."

#: dat/rumors.fal:198
msgid "[cookie] They say that a gypsy could tell your fortune for a price."
msgstr ""
"[galleta] Dicen que una gitana podría decirte la fortuna por un precio."

#: dat/rumors.fal:253
msgid "[cookie] They say that fortune cookies are food for thought."
msgstr ""
"[galleta] Dicen que las galletas de la fortuna son alimento para el "
"pensamiento."

#: dat/rumors.fal:355
msgid "[cookie] This fortune cookie is copy protected."
msgstr "[galleta] Esta galleta de la fortuna está protegida contra copia."

#: dat/rumors.fal:356
msgid "[cookie] This fortune cookie is the property of Fortune Cookies, Inc."
msgstr ""
"[galleta] Esta galleta de la fortuna es propiedad de Fortune Cookies, Inc."

#: dat/rumors.fal:371
msgid "[cookie] Warning:  fortune reading can be hazardous to your health."
msgstr "[galleta] Aviso:  leer la fortuna puede ser peligroso para tu salud."

#: dat/rumors.fal:374
msgid "[cookie] What a pity, you cannot read it!"
msgstr "[galleta] ¡Qué lástima, no puedes leerla!"

#: dat/rumors.fal:379
msgid "[cookie] Why are you wasting time reading fortunes?"
msgstr "[galleta] ¿Por qué pierdes el tiempo leyendo fortunas?"

#: dat/rumors.fal:384
msgid "[cookie] You are destined to be misled by a fortune."
msgstr "[galleta] Estás destinado a ser engañado por una fortuna."

#: dat/rumors.fal:389
msgid "[cookie] You choke on the fortune cookie.  --More--"
msgstr "[galleta] Te atragantas con la galleta de la fortuna.  --More--"

#: dat/rumors.fal:392
msgid "[cookie] You hear the fortune cookie's hissing!"
msgstr "[galleta] ¡Oyes el siseo de la galleta de la fortuna!"

#: dat/rumors.fal:395
msgid "[cookie] You swallowed the fortune!"
msgstr "[galleta] ¡Te has tragado la fortuna!"

