msgid "%s"
msgstr "%s"

#: src/mhitu.c:299
msgid "Brrooaa...  You land hard at some distance."
msgstr "Brrooaa...  Aterrizas fuerte a cierta distancia."

#: src/mhitu.c:555
#, c-format
msgid "fall from the %s!"
msgstr "caer de la %s !"

#: src/mhitu.c:596
#, c-format
msgid "blow glances off %s %s."
msgstr "el golpe echa un vistazo %s %s ."

#: src/mhitu.c:599
#, c-format
msgid "%s is hit by a falling piercer (you)!"
msgstr "%s es golpeada por un muelle cayendo (usted)!"

#: src/mhitu.c:603
#, c-format
msgid "%s is almost hit by a falling piercer (you)!"
msgstr "%s es casi atropellado por un muelle cayendo (usted)!"

#: src/mhitu.c:609
msgid "It tries to move where you are hiding."
msgstr "Intenta moverse hacia donde te escondes."

#: src/mhitu.c:633
#, c-format
msgid "Wait, %s!  There's a hidden %s named %s there!"
msgstr "¡Espera, %s! ¡Hay un %s escondido llamado %s ahí!"

#: src/mhitu.c:635
#, c-format
msgid "Wait, %s!  There's a %s named %s hiding under %s!"
msgstr "¡Espera, %s! ¡Hay un %s llamado %s escondido bajo %s!"

#: src/mhitu.c:639
msgid "hiding under nothing?"
msgstr ""

#: src/mhitu.c:654
msgid "It gets stuck on you."
msgstr "Se queda pegado a ti."

#: src/mhitu.c:656
#, c-format
msgid "Wait, %s!  That's a %s named %s!"
msgstr "¡Espera, %s! ¡Es un %s llamado %s!"

