#, c-format
msgid "%s %s!"
msgstr "%s %s!"

#: src/mhitu.c:675
#, c-format
msgid "Wait, %s!  That %s is really %s named %s!"
msgstr "¡Espera, %s! ¡Que %s es realmente %s llamado %s!"

#: src/mhitu.c:679
msgid "You appear to be %s again."
msgstr "Vuelves a tu auto. %s"
#: src/mhitu.c:729
#, c-format
msgid "%s starts to attack you, but pulls back."
msgstr "%s empieza a atacarte, pero retrocede."

#: src/mhitu.c:731
#, c-format
msgid "%s move nearby."
msgstr "%s se mueve cerca."

#: src/mhitu.c:845
#, c-format
msgid "a %s nearby."
msgstr "a %s cerca."

#: src/mhitu.c:978 src/mhitu.c:993
msgid "hemmed in."
msgstr "entrometido."

#: src/mhitu.c:980
msgid "But none comes."
msgstr "Pero no viene ninguno."

#: src/mhitu.c:996 src/apply.c:589
msgid "%s appears"
msgstr "Aparece. %s"
#: src/mhitu.c:998
#, c-format
msgid "%s appear"
msgstr ""

#: src/mhitu.c:1000 src/ball.c:899 src/ball.c:902 src/ball.c:908 src/ball.c:912
#: src/attrib.c:194
#, c-format
msgid "%s%s!"
msgstr "%s%s!"

#: src/mhitu.c:1013
msgid "a slight illness."
msgstr "una pequeña enfermedad."

#: src/mhitu.c:1055 src/uhitm.c:2063
msgid "grease wears off."
msgstr ""
#: src/mhitu.c:1157
#, c-format
msgid "%s was hidden under %s!"
msgstr "%s estaba escondido bajo %s !"

#: src/mhitu.c:1297
#, c-format
msgid "%s %s forward and plucks you off %s!"
msgstr "¡%s %s hacia adelante y te arranca de %s!"

#: src/mhitu.c:1321
#, c-format
msgid "are released from the %s!"
msgstr "son liberados del %s !"

#: src/mhitu.c:1329 src/dokick.c:617
#, c-format
msgid "%s %s loose."
msgstr "Tranquila. %s %s"

#: src/mhitu.c:1402
#, c-format
msgid "%s totally digests you!"
msgstr "%s te digiere totalmente!"

#: src/mhitu.c:1407
#, c-format
msgid "%s%s digests you!"
msgstr "¡%s%s te digiere!"

#: src/mhitu.c:1415
#, c-format
msgid "are laden with moisture and %s"
msgstr "están cargados de humedad y %s"

#: src/mhitu.c:1424
#, c-format
msgid "are %s!"
msgstr "son %s !"

#: src/mhitu.c:1431
msgid "are covered with a seemingly harmless goo."
msgstr "estás cubierto de una sustancia aparentemente inofensiva."

#: src/mhitu.c:1438
msgid "Ouch!  You've been slimed!"
msgstr "¡Ay!  ¡Has sido bañado en moho!"

#: src/mhitu.c:1440
msgid "are covered in slime!  It burns!"
msgstr "¡estás cubierto de moho!  ¡Quema!"

#: src/mhitu.c:1451
msgid "see in here!"
msgstr "¡ver aquí dentro!"

#: src/mhitu.c:1463
msgid "air around you crackles with electricity."
msgstr "estás jolted with electricity!"
#: src/mhitu.c:1466
msgid "seem unhurt."
msgstr "pareces ileso."

#: src/mhitu.c:1480
msgid "mildly chilly."
msgstr "ligeramente frío."

#: src/mhitu.c:1485
msgid "are freezing to death!"
msgstr "¡te estás congelando hasta morir!"

#: src/mhitu.c:1495
msgid "mildly hot."
msgstr "ligeramente caliente."

#: src/mhitu.c:1500
msgid "are burning to a crisp!"
msgstr "¡te estás quemando hasta quedar hecho cenizas!"

#: src/mhitu.c:1542
#, c-format
msgid "%s very hurriedly %s you!"
msgstr "%s muy apresuradamente %s usted!"

#: src/mhitu.c:1551
#, c-format
msgid "get %s!"
msgstr "¡Consigue a %s!"

#: src/mhitu.c:1556
#, c-format
msgid "Obviously %s doesn't like your taste."
msgstr "Obviamente %s no le gusta tu gusto."

#: src/mhitu.c:1580
#, c-format
msgid "%s explodes at a spot in %s!"
msgstr "%s explota en un lugar en %s !"

#: src/mhitu.c:1599
msgid "are blinded by a blast of light!"
msgstr "¡eres cegado por una explosión de luz!"

#: src/mhitu.c:1604
msgid "get the impression it was not terribly bright."
msgstr "tienes la impresión de que no era muy brillante."

#: src/mhitu.c:1614
msgid "are caught in a blast of kaleidoscopic light!"
msgstr "¡eres atrapado en una explosión de luz caleidoscópica!"

