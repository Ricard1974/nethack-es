#: src/mhitu.c:240
#, c-format
msgid "%s strikes at your %sdisplaced image and misses you!"
msgstr "%s golpea tu imagen desplazada %s y te extraña!"

#: src/mhitu.c:249
#, c-format
msgid "%s reaches towards your distorted image."
msgstr "%s llega hacia tu imagen distorsionada."

#: src/mhitu.c:251
#, c-format
